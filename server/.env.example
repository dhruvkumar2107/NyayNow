# -------------------------
# Basic service settings
# -------------------------
PORT=4000
MONGO_URI=mongodb://localhost:27017/nyaynow
JWT_SECRET=your_jwt_secret_here_generate_with_openssl

# Python microservice URL
PYTHON_AI_URL=http://localhost:8000

# -------------------------
# Gemini / LLM
# -------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# -------------------------
# Razorpay (Payments)
# -------------------------
RZP_KEY_ID=your_razorpay_key_id_here
RZP_KEY_SECRET=your_razorpay_key_secret_here

# Optional plan amounts (₹)
RZP_AMOUNT_SILVER=299
RZP_AMOUNT_GOLD=599
RZP_AMOUNT_DIAMOND=999

# -------------------------
# SMS / OTP providers (MSG91)
# -------------------------
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_SENDER_ID=TXTLCL

# -------------------------
# Twilio (optional)
# -------------------------
TWILIO_ACCOUNT_SID=your_twilio_sid_here
TWILIO_AUTH_TOKEN=your_twilio_token_here
TWILIO_FROM_NUMBER=your_twilio_phone_number_here

# Cloudinary (uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Debug
DEBUG=false

# -------------------------
# DOCUSIGN INTEGRATION
# -------------------------
DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key_here
DOCUSIGN_USER_ID=your_docusign_user_id_here
DOCUSIGN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_docusign_private_key_here\n-----END RSA PRIVATE KEY-----"

# -------------------------
# INDIAN KANOON INTEGRATION
# -------------------------
# Obtain a key by registering at api.indiankanoon.org
INDIANKANOON_API_KEY=your_indian_kanoon_token_here
